# 通义千问（推荐中文）。也可换成任何 OpenAI 兼容网关。
# 必须带 /v1。只写网关域名会打到网站首页 HTML，出现 choices 报错。
# 百炼：https://dashscope.aliyuncs.com/compatible-mode/v1
# 其他 OpenAI 兼容网关：https://你的域名/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# 当前会话用户（模拟已登录）。评测默认 CUS10001。
DEFAULT_CUSTOMER_ID=CUS10001
